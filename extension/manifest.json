{
  "manifest_version": 3,
  "name": "Lustify CRM Bridge",
  "version": "0.2.0",
  "description": "Telegram CRM companion — contact lookup, labels, notes, and quick actions from within Telegram Web.",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://web.telegram.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lustify CRM"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
