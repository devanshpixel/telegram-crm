{
  "manifest_version": 3,
  "name": "Lustify CRM Bridge",
  "version": "0.1.0",
  "description": "Read CRM contacts from the Lustify CRM dashboard.",
  "permissions": [],
  "host_permissions": ["http://localhost:3000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lustify CRM"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
