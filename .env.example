# Telegram CRM — environment configuration
#
# 1. Copy this file to .env:    cp .env.example .env
#    (Windows PowerShell:      Copy-Item .env.example .env)
# 2. Fill in the two values below.
# 3. The .env file is gitignored. Never commit it.
#
# How to obtain TELEGRAM_API_ID and TELEGRAM_API_HASH:
#   - Visit https://my.telegram.org/apps
#   - Sign in with the Telegram account that will send messages
#   - Click "Create new application" (name + short description; both can be anything)
#   - Copy the numeric api_id and the 32-character api_hash into this file
#
# Do NOT store a Telegram session string in this file.
# Sessions are persisted in the SQLite database (table: telegram_sessions)
# after running the login CLI script:  npm run telegram:login
# See README.md → "Telegram login" for the full flow.

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# AI Reply Assistant — OpenRouter API key
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# API key for middleware auth (protect API routes)
# Must be at least 32 hex characters (128 bits) for production.
# The extension will also use this key.
CRM_API_KEY=16be7932a405cf8d

# Application URL (used for Razorpay callback redirect after payment)
# Must match the actual deployment URL. Defaults to http://localhost:3000
# APP_URL=https://your-crm-domain.com

# Razorpay — payment processing (India-first, UPI + cards/NetBanking)
# Get keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Settings → Webhooks
# Create a webhook with event "payment_link.paid" pointing to:
#   https://your-domain.com/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=
