# Telegram CRM — environment configuration
#
# 1. Copy this file to .env:    cp .env.example .env
#    (Windows PowerShell:      Copy-Item .env.example .env)
# 2. Fill in the values below.
# 3. The .env file is gitignored. Never commit it.
#
# How to obtain TELEGRAM_API_ID and TELEGRAM_API_HASH:
#   - Visit https://my.telegram.org/apps
#   - Sign in with the Telegram account that will send messages
#   - Click "Create new application" (name + short description; both can be anything)
#   - Copy the numeric api_id and the 32-character api_hash into this file
#
# Session string from a previous successful Telegram login.
# Alternative to database-stored session. If set, takes precedence.
# Obtain by running: npm run telegram:login
# Then copy the printed session string here.
TELEGRAM_SESSION=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram Proxy (Optional)
# Use if Telegram is blocked on your network
# TELEGRAM_USE_WSS=true       # Use WebSockets (port 443)
# TELEGRAM_PROXY_HOST=127.0.0.1
# TELEGRAM_PROXY_PORT=1080
# TELEGRAM_PROXY_TYPE=socks5  # socks5, http, or mtproxy
# TELEGRAM_PROXY_USER=
# TELEGRAM_PROXY_PASS=
# TELEGRAM_PROXY_SECRET=      # For mtproxy only

# AI Reply Assistant — OpenRouter API key
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# API key for middleware auth (protect API routes)
# Must be at least 32 hex characters (128 bits) for production.
# The extension will also use this key.
CRM_API_KEY=16be7932a405cf8d

# Application URL (used for Razorpay callback redirect after payment)
# Must match the actual deployment URL. Defaults to http://localhost:3000
# APP_URL=https://your-crm-domain.com

# Razorpay — payment processing (India-first, UPI + cards/NetBanking)
# Get keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Settings → Webhooks
# Create a webhook with event "payment_link.paid" pointing to:
#   https://your-domain.com/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=

# NOTE: OFFER_PRICE is NOT read by the application. The offer price is managed
# entirely through the Settings panel in the dashboard (stored in the DB as rupees,
# default ₹499). This env var is documented for reference only — setting it has no effect.
# OFFER_PRICE=499

# Turso (serverless SQLite) — REQUIRED for Vercel/cloud deployment.
# Without this, the app falls back to /tmp/crm.db which is wiped on every cold start.
# Get these by running: turso db create <name> && turso db show <name> --url && turso db tokens create <name>
# TURSO_DB_URL=libsql://your-db.turso.io
# TURSO_DB_TOKEN=your-token
